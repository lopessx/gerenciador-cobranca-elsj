# =============================================================================
# CONFIGURAÇÃO DE AMBIENTE — Symfony / Cobri Backend
# =============================================================================
# Este arquivo define as variáveis de ambiente padrão da aplicação.
# Prioridade de carregamento (do menor para o maior):
#   1. .env                 (valores padrão)
#   2. .env.local           (sobrescritas locais, não versionado)
#   3. .env.$APP_ENV        (sobrescritas por ambiente)
#   4. .env.$APP_ENV.local  (sobrescritas locais por ambiente)
# Variáveis reais do sistema operacional sempre têm prioridade máxima.
# =============================================================================

# ---------------------------------------------------------------------------
# APLICAÇÃO
# ---------------------------------------------------------------------------
# APP_ENV: ambiente de execução (dev, test, prod)
APP_ENV=dev

# APP_SECRET: chave secreta usada para geração de tokens CSRF, cookies, etc.
#             ALTERE em produção! Use um valor aleatório de 32+ caracteres hex.
APP_SECRET=4135c91ecd5b4bbb7a26ab20e5e79e32

# ---------------------------------------------------------------------------
# BANCO DE DADOS (MySQL 8.0 via Docker)
# ---------------------------------------------------------------------------
# DATABASE_URL: string de conexão Doctrine DBAL
#   formato: mysql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO?serverVersion=VERSAO
#   O container MySQL é iniciado pelo docker-compose.yml na raiz do projeto.
DATABASE_URL="mysql://admin:admin@127.0.0.1:3306/app_db?serverVersion=8.0"

# ---------------------------------------------------------------------------
# JWT — LexikJWTAuthenticationBundle
# ---------------------------------------------------------------------------
# JWT_SECRET_KEY: caminho para a chave privada PEM usada para assinar tokens
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem

# JWT_PUBLIC_KEY: caminho para a chave pública PEM usada para verificar tokens
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# JWT_PASSPHRASE: frase secreta para descriptografar a chave privada JWT
#                 ALTERE em produção!
JWT_PASSPHRASE=b88487e5483294d46231072a8f9fddbe928525930b6bb8af21323ae90f8f52a4

# ---------------------------------------------------------------------------
# SEED — Usuário padrão de testes (app:seed-user)
# ---------------------------------------------------------------------------
# DEFAULT_ADMIN_EMAIL: e-mail do usuário admin criado automaticamente pelo seed
DEFAULT_ADMIN_EMAIL=admin@admin.com

# DEFAULT_ADMIN_PASSWORD: senha em texto plano do usuário admin (será hasheada)
#                         ATENÇÃO: altere em ambientes de produção!
DEFAULT_ADMIN_PASSWORD=123456789
