# =============================================================================
# CONFIGURAÇÃO DE AMBIENTE — Cobri (Raiz do Projeto)
# =============================================================================
# Este arquivo centraliza variáveis compartilhadas entre backend e infraestrutura.
# O backend Symfony lê suas próprias variáveis de backend/.env
# =============================================================================

# ---------------------------------------------------------------------------
# DOCKER / MYSQL
# ---------------------------------------------------------------------------
# Credenciais do container MySQL (devem coincidir com docker-compose.yml)
MYSQL_ROOT_PASSWORD=admin
MYSQL_USER=admin
MYSQL_PASSWORD=admin
MYSQL_DATABASE=app_db

# ---------------------------------------------------------------------------
# BACKEND — Symfony
# ---------------------------------------------------------------------------
# Ambiente de execução do Symfony
APP_ENV=dev

# Chave secreta da aplicação (CSRF, cookies, etc.)
APP_SECRET=4135c91ecd5b4bbb7a26ab20e5e79e32

# String de conexão com o banco (usada pelo Doctrine)
DATABASE_URL="mysql://admin:admin@127.0.0.1:3306/app_db?serverVersion=8.0"

# ---------------------------------------------------------------------------
# JWT — LexikJWTAuthenticationBundle
# ---------------------------------------------------------------------------
# Caminhos das chaves PEM para assinatura/verificação de tokens
JWT_SECRET_KEY=backend/config/jwt/private.pem
JWT_PUBLIC_KEY=backend/config/jwt/public.pem

# Frase secreta da chave privada JWT
JWT_PASSPHRASE=b88487e5483294d46231072a8f9fddbe928525930b6bb8af21323ae90f8f52a4

# ---------------------------------------------------------------------------
# SEED — Usuário padrão de testes
# ---------------------------------------------------------------------------
# E-mail e senha do admin criado pelo comando app:seed-user
DEFAULT_ADMIN_EMAIL=admin@admin.com
DEFAULT_ADMIN_PASSWORD=123456789
